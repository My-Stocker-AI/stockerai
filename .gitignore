# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
MEMORY.md

# Credentials — never commit; secrets live in the deploy platform's env vars.
# (These were committed historically — rotation + untracking is a separate coordinated step.)
.env
.env.*
!.env.example
.mcp.json
**/INCREMENT_*KEY*.js
.gstack/

# Build/test artifacts — regenerated, never commit
__pycache__/
**/__pycache__/
*.pyc
playwright-report/
test-results/
.playwright-mcp/

# Parked native app shell (Capacitor) — kept ON DISK, not part of the web deploy.
# These come back into git if/when the native path is un-parked.
android/
ios/
capacitor.config.ts
src/native/

# XF platform state (regenerated tool state)
**/.xf/

# Supabase CLI scratch — rewritten on every command, never worth committing
supabase/.temp/
